# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Local dev default matches the local PostgreSQL instance created for this project.
DATABASE_URL=postgresql+psycopg2://risk_engine:CHANGE_ME@localhost:5432/portfolio_risk_engine
# Used only by the test suite (tests/conftest.py); a separate DB avoids clobbering dev data.
TEST_DATABASE_URL=postgresql+psycopg2://risk_engine:CHANGE_ME@localhost:5432/portfolio_risk_engine_test
# Used only by docker-compose.yml to initialise the `db` service's Postgres superuser password.
POSTGRES_PASSWORD=CHANGE_ME

# --- API security ---
# Required header (X-API-Key) on all write endpoints. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME

# --- Monte Carlo ---
# Default random seed used when a risk-run request does not supply one explicitly.
# Fixed default (not random) so out-of-the-box runs are reproducible.
MC_DEFAULT_SEED=42

# --- Data vendor ---
# yfinance/stooq need no API key. DATA_SOURCE selects the primary vendor; falls back to the other on failure.
DATA_SOURCE=yfinance

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
